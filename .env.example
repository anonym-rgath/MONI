# Pflicht: Schlüssel für die verschlüsselten Agent-Tokens im Manager.
# Erzeugen mit: docker build --target manager -t moni-manager . && docker run --rm moni-manager python -m moni.cli secret generate
# (oder: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"). Nie einchecken, sicher sichern.
MONI_SECRET_KEY=

# Optional: Bind-Adresse des Managers (Standard 127.0.0.1; HTTPS auf Port 8443, Port 8080 leitet auf https um).
# Auch mit MONI_TLS=off bleibt 127.0.0.1 sinnvoll: Nur der Proxy davor soll den Manager erreichen (D8a).
# MONI_MANAGER_BIND=127.0.0.1

# Images: Compose nutzt die veröffentlichten GHCR-Images. Lokal bauen:
#   docker build --target agent -t moni-agent:local . && docker build --target manager -t moni-manager:local .
# und dann MONI_AGENT_IMAGE=moni-agent:local bzw. MONI_MANAGER_IMAGE=moni-manager:local setzen.
# MONI_AGENT_IMAGE=ghcr.io/anonym-rgath/moni-agent:2.0.0
# MONI_MANAGER_IMAGE=ghcr.io/anonym-rgath/moni-manager:2.0.0

# Socket-Proxy: Gruppen-ID des Docker-Sockets auf dem Host (Linux): stat -c %g /var/run/docker.sock
# Pflicht; die scripts/*.sh ermitteln den Wert selbst (macOS Docker Desktop: 0).
# DOCKER_GID=999

API_CORS_ORIGINS=

# Optionale Feintuning-Parameter (Defaults greifen, wenn nicht gesetzt):
# DOCKER_STATS_TIMEOUT=2.5     # Timeout (Sek.) je Docker-Stats-Abfrage
# DOCKER_INSPECT_TIMEOUT=1.0   # Timeout (Sek.) je Container-Inspect
# MAX_DOCKER_WORKERS=8         # Parallele Worker fuer Container-Metriken

# Optional, nur Manager (compose.manager.yaml):
# MONI_COLLECT_INTERVAL=15         # Mess- und Abruftakt (Sek.)
# MONI_POLL_TIMEOUT=10             # Timeout (Sek.) je Abruf eines Agents
# MONI_RETENTION_RAW_HOURS=48      # Aufbewahrung Rohdaten (Stunden)
# MONI_RETENTION_MINUTE_DAYS=30    # Aufbewahrung Minutenwerte (Tage)
# MONI_RETENTION_HOUR_DAYS=365     # Aufbewahrung Stundenwerte (Tage)

# Anmeldung (nur Manager). Das Session-Cookie ist immer "Secure": Die Browser-Anmeldung braucht HTTPS
# (Manager-TLS, siehe unten) oder einen HTTPS-Proxy. API-Clients mit Bearer-Token sind nicht betroffen.
# MONI_SESSION_IDLE_MINUTES=60     # Abmeldung nach Leerlauf (Minuten)
# MONI_SESSION_MAX_HOURS=12        # absolute Sitzungsdauer (Stunden)

# TLS und Kopplung (Manager und Agent)
# MONI_TLS=on                      # on (Standard, sicherer) = HTTPS; off nur hinter einem vertrauenswürdigen Proxy (D8)
# MONI_HTTPS_PORT=8443             # nur Manager: veröffentlichter HTTPS-Port auf dem Host (für Umleitung und Healthcheck)
# MONI_MANAGER_HOSTNAMES=          # nur Manager: Namen/IPs im HTTPS-Zertifikat, kommagetrennt (Standard: Hostname,localhost,127.0.0.1)
# MONI_PUBLIC_URL=                 # nur Agent: https://<Host>:9810, wird in den Kopplungscode eingebettet (sonst gibt der Admin die URL an)
# MONI_TRUSTED_PROXIES=            # IPs/CIDRs vertrauenswürdiger Proxys, kommagetrennt; gilt nur bei MONI_TLS=off (X-Forwarded-For)
#
# D6: Der Agent-Port 9810 ist standardmäßig nur auf 127.0.0.1 gebunden. Damit ein Manager auf einem anderen
# Rechner den Agent per mTLS erreicht, setzen Sie MONI_AGENT_BIND=0.0.0.0 (und beschränken den Zugriff per Firewall
# auf den Manager). Der Agent akzeptiert dann nur den gekoppelten Manager per Zertifikat und Fremdsysteme per Token.
# MONI_AGENT_BIND=127.0.0.1
#
# D8: MONI_TLS=off nur, wenn ein vertrauenswürdiger Proxy (z. B. Cloudflare Tunnel) das TLS abschließt. Tragen Sie
# dessen Adresse in MONI_TRUSTED_PROXIES ein, damit Drosselung und Rate-Limit pro echtem Client wirken. Solche
# Server laufen im schwächeren Token-Modus (security "token") statt mit mTLS.

# Alarmierung: Kanäle (Webhook, E-Mail) und Regeln werden per API (/api/v1/alert-channels, /api/v1/alert-rules)
# und später in der Oberfläche verwaltet, nicht über Umgebungsvariablen. SMTP funktioniert nur mit STARTTLS oder TLS.
