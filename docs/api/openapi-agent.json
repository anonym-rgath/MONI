{
  "components": {
    "schemas": {
      "CertBody": {
        "additionalProperties": false,
        "properties": {
          "ca": {
            "maxLength": 16384,
            "title": "Ca",
            "type": "string"
          },
          "certificate": {
            "maxLength": 16384,
            "title": "Certificate",
            "type": "string"
          }
        },
        "required": [
          "certificate",
          "ca"
        ],
        "title": "CertBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "NewToken": {
        "additionalProperties": false,
        "description": "Eingabe für neue Tokens; Manager-API erweitert um scope, der Agent nimmt sie unverändert (immer read).",
        "properties": {
          "expires_days": {
            "anyOf": [
              {
                "maximum": 3650.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires Days"
          },
          "name": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "NewToken",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
